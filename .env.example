DATABASE_URL="postgresql://user:password@localhost:5432/lats?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
NODE_ENV=development
FILE_STORAGE_DIR="./uploads"
# Comma-separated list of origins allowed to call this API from a browser.
# "*" (the default if unset) allows any origin — fine for local dev, but
# set this to a real list before deploying anywhere reachable outside
# your own machine, e.g.:
# CORS_ALLOWED_ORIGINS="https://lats.example.com,https://lats-staging.example.com"
CORS_ALLOWED_ORIGINS="*"
