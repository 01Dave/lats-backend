DATABASE_URL="postgresql://user:password@localhost:5432/lats?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
NODE_ENV=development
FILE_STORAGE_DIR="./uploads"
# Comma-separated list of origins allowed to call this API from a browser.
# "*" (the default if unset) allows any origin — fine for local dev, but
# set this to a real list before deploying anywhere reachable outside
# your own machine, e.g.:
# CORS_ALLOWED_ORIGINS="https://lats.example.com,https://lats-staging.example.com"
CORS_ALLOWED_ORIGINS="*"
# Login throttling: max attempts per IP+email within the window before
# /auth/login returns 429. Defaults shown. A set-but-invalid value stops
# the server at boot rather than silently disabling the limit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Number of reverse proxies in front of this server (ngrok, nginx, a
# hosting platform's load balancer). 0 = none. Set to 1 behind a single
# proxy so the throttle sees real client IPs instead of the proxy's.
TRUST_PROXY_HOPS=0

# Outgoing email: when a loan is rejected at any stage (HOD, Credit Review,
# Internal Control or MD), the Sales officer who started it is emailed. OFF
# unless SMTP_HOST is set; leave it all blank to run without email.
# Get these from IT. SMTP_USER and SMTP_PASSWORD go together (omit both for a
# relay that needs no login). MAIL_FROM can be left out if SMTP_USER is itself
# an email address. Port 465 means TLS from the start; 587 uses STARTTLS.
# For local testing without a real server: `npm run fake-smtp`, then use
# SMTP_HOST=127.0.0.1, SMTP_PORT=1025, MAIL_FROM="LATS <lats-noreply@bank.test>".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only if the bank's mail server uses a self-signed certificate. Discouraged.
SMTP_ALLOW_INVALID_CERT=false
