generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches config/roles.ts RoleName type exactly — keep both in sync.
enum RoleName {
  sales
  hod
  credit_review
  internal_control
  md
  finance
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         RoleName
  // Deprecated: the bank is single-branch, so nothing reads or writes this
  // any more. Kept (not dropped) so existing data is untouched.
  branch       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicationsCreated Application[] @relation("ApplicationCreatedBy")
  applicationsOwned   Application[] @relation("ApplicationOwner")
  assignmentsReceived Assignment[]  @relation("AssignmentAssignee")
  assignmentsMade     Assignment[]  @relation("AssignmentAssignedBy")
  approvals           Approval[]
  comments            Comment[]

  @@map("users")
}

// Matches workflow/statuses.ts ApplicationStatus type exactly — keep both in sync.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  HOD_IN_REVIEW
  HOD_QUERY
  HOD_APPROVED
  HOD_REJECTED
  CREDIT_IN_REVIEW
  CREDIT_QUERY
  CREDIT_APPROVED
  CREDIT_DECLINED
  IC_IN_REVIEW
  IC_QUERY
  IC_APPROVED
  IC_REJECTED
  PENDING_MD
  MD_APPROVED
  MD_REJECTED
  PENDING_DISBURSEMENT
  DISBURSED
  WITHDRAWN
}

// Header fields (spec Section 8.1 loan_applications). Customer/product are
// flat fields, not their own tables — this is a digital tracker for a
// physical paper-trail process (per-application confirmation, no BVN, no
// digital KYC verification), so there's no ongoing identity or per-product
// configuration to normalize. Documents ARE kept, independent of KYC —
// see Document below.
model Application {
  id               String            @id @default(uuid())
  appNumber        String            @unique
  status           ApplicationStatus @default(DRAFT)
  // Single-branch bank: not an input any more, always takes this default.
  // Column kept so existing rows and reporting stay intact.
  branch           String            @default("Main")
  productName      String
  customerName     String
  customerPhone    String
  requestedAmount  Decimal           @db.Decimal(14, 2)
  tenorMonths      Int
  purpose          String

  // Physical KYC confirmation (paper-trail process — no digital checklist).
  // Set as a side effect of HOD's approval decision, not a separate
  // endpoint — see approval-service.ts hodDecision().
  kycConfirmed     Boolean           @default(false)
  kycConfirmedById String?
  kycConfirmedAt   DateTime?

  // Disbursement (Finance, finance_disburse: PENDING_DISBURSEMENT -> DISBURSED).
  // Same pattern as kycConfirmed* above — set as a side effect of the one
  // disbursement decision call, not a separate table. One disbursement per
  // application; there's no partial/tranche disbursement in scope.
  disbursedAmount       Decimal?  @db.Decimal(14, 2)
  disbursementDate      DateTime?
  disbursementMethod    String?
  disbursementReference String?
  disbursedById         String?
  disbursedAt           DateTime?

  createdById      String
  createdBy        User              @relation("ApplicationCreatedBy", fields: [createdById], references: [id])

  // Case owner: the one person responsible for the case at its CURRENT
  // stage. Display only — it never gates who may act (the state machine
  // does that). Set automatically on every transition (see
  // services/assignment-service.ts) and null once the case is closed.
  ownerId          String?
  owner            User?             @relation("ApplicationOwner", fields: [ownerId], references: [id])

  documents        Document[]
  approvals        Approval[]
  comments         Comment[]
  assignments      Assignment[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([ownerId])
  @@map("loan_applications")
}

enum DocumentStatus {
  pending
  verified
  rejected
  expired
}

// Vetted independently of any checklist — whoever reviews a document just
// flips its status directly. docType is a free descriptor, not tied to
// any template (there is no KYC checklist template in this version of
// the system). Still versioned (FR-22/23 intent) — a re-upload of the
// same docType keeps the old version rather than overwriting it.
model Document {
  id             String         @id @default(uuid())
  applicationId  String
  application    Application    @relation(fields: [applicationId], references: [id])
  docType        String
  filename       String
  storagePath    String
  version        Int            @default(1)
  current        Boolean        @default(true)
  uploadedById   String
  status         DocumentStatus @default(pending)
  uploadedAt     DateTime       @default(now())

  @@map("documents")
}

// Backs LN-{YYYY}-{SEQUENCE} generation (spec Section 8.2) with an atomic
// per-year counter row, avoiding the race condition of a plain max()+1 scan
// under concurrent submissions.
model AppNumberCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("app_number_counters")
}

enum ApprovalStage {
  HOD
  CREDIT_REVIEW
  INTERNAL_CONTROL
  MD
  FINANCE
  WITHDRAWAL
}

enum ApprovalDecision {
  APPROVE
  QUERY
  DECLINE
  REJECT
  RESOLVE
  WITHDRAW
  DISBURSE
}

// One row per decision event — the structured, queryable record behind
// the state machine's transitions (Section 6.2). `comment` holds whatever
// text came with the decision (mandatory for QUERY/DECLINE/REJECT/WITHDRAW,
// optional for APPROVE/RESOLVE... actually RESOLVE requires one too, see
// approval-service.ts) rather than duplicating it into a separate Comment
// row. `stage` is null only for query resolutions (RESOLVE), which aren't
// owned by any one approval stage; withdrawal uses stage WITHDRAWAL.
model Approval {
  id              String            @id @default(uuid())
  applicationId   String
  application     Application       @relation(fields: [applicationId], references: [id])
  stage           ApprovalStage?
  decision        ApprovalDecision
  actorId         String
  actor           User              @relation(fields: [actorId], references: [id])
  comment         String?
  resultingStatus ApplicationStatus
  createdAt       DateTime          @default(now())

  @@map("approvals")
}

// Free-standing case notes — separate from the comment attached to a
// specific decision (which lives on Approval.comment above). General
// commentary anyone with comment:create can add at any point.
model Comment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())

  @@map("comments")
}

// History of who held each case and when it changed hands. One row per
// assignment, written in the same transaction as the status change that
// caused it (or the manual reassignment). assignedById is null for
// automatic assignment. `status` is the application's status at that
// moment, so the history reads "HOD_IN_REVIEW -> Ada", etc.
model Assignment {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  assigneeId    String
  assignee      User              @relation("AssignmentAssignee", fields: [assigneeId], references: [id])
  assignedById  String?
  assignedBy    User?             @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  status        ApplicationStatus
  createdAt     DateTime          @default(now())

  @@index([applicationId])
  @@index([assigneeId])
  @@map("case_assignments")
}
