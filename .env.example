DATABASE_URL="postgresql://user:password@localhost:5432/lats?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
NODE_ENV=development
FILE_STORAGE_DIR="./uploads"
# Comma-separated list of origins allowed to call this API from a browser.
# "*" (the default if unset) allows any origin — fine for local dev, but
# set this to a real list before deploying anywhere reachable outside
# your own machine, e.g.:
# CORS_ALLOWED_ORIGINS="https://lats.example.com,https://lats-staging.example.com"
CORS_ALLOWED_ORIGINS="*"
# Login throttling: max attempts per IP+email within the window before
# /auth/login returns 429. Defaults shown. A set-but-invalid value stops
# the server at boot rather than silently disabling the limit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Number of reverse proxies in front of this server (ngrok, nginx, a
# hosting platform's load balancer). 0 = none. Set to 1 behind a single
# proxy so the throttle sees real client IPs instead of the proxy's.
TRUST_PROXY_HOPS=0
