generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches config/roles.ts RoleName type exactly — keep both in sync.
enum RoleName {
  sales
  hod
  credit_review
  internal_control
  md
  finance
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         RoleName
  branch       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicationsCreated Application[] @relation("ApplicationCreatedBy")

  @@map("users")
}

// Matches workflow/statuses.ts ApplicationStatus type exactly — keep both in sync.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  HOD_IN_REVIEW
  HOD_QUERY
  HOD_APPROVED
  CREDIT_IN_REVIEW
  CREDIT_QUERY
  CREDIT_APPROVED
  CREDIT_DECLINED
  IC_IN_REVIEW
  IC_QUERY
  IC_APPROVED
  IC_REJECTED
  PENDING_MD
  MD_APPROVED
  MD_REJECTED
  PENDING_DISBURSEMENT
  DISBURSED
  WITHDRAWN
}

// Header fields (spec Section 8.1 loan_applications). Customer/product are
// flat fields, not their own tables — this is a digital tracker for a
// physical paper-trail process (per-application confirmation, no BVN, no
// digital KYC verification), so there's no ongoing identity or per-product
// configuration to normalize. Documents ARE kept, independent of KYC —
// see Document below.
model Application {
  id               String            @id @default(uuid())
  appNumber        String            @unique
  status           ApplicationStatus @default(DRAFT)
  branch           String
  productName      String
  customerName     String
  customerPhone    String
  requestedAmount  Decimal           @db.Decimal(14, 2)
  tenorMonths      Int
  purpose          String

  createdById      String
  createdBy        User              @relation("ApplicationCreatedBy", fields: [createdById], references: [id])

  documents        Document[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("loan_applications")
}

enum DocumentStatus {
  pending
  verified
  rejected
  expired
}

// Vetted independently of any checklist — whoever reviews a document just
// flips its status directly. docType is a free descriptor, not tied to
// any template (there is no KYC checklist template in this version of
// the system). Still versioned (FR-22/23 intent) — a re-upload of the
// same docType keeps the old version rather than overwriting it.
model Document {
  id             String         @id @default(uuid())
  applicationId  String
  application    Application    @relation(fields: [applicationId], references: [id])
  docType        String
  filename       String
  storagePath    String
  version        Int            @default(1)
  current        Boolean        @default(true)
  uploadedById   String
  status         DocumentStatus @default(pending)
  uploadedAt     DateTime       @default(now())

  @@map("documents")
}

// Backs LN-{YYYY}-{SEQUENCE} generation (spec Section 8.2) with an atomic
// per-year counter row, avoiding the race condition of a plain max()+1 scan
// under concurrent submissions.
model AppNumberCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("app_number_counters")
}
